{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "structure",
            "transport",
            "actuator_pneumatic",
            "actuator_electric",
            "robot",
            "sensor",
            "work_carrier",
            "feeder",
            "process",
            "mover",
            "building"
          ]
        },
        "fidelity": {
          "default": "L2",
          "type": "string",
          "enum": [
            "L1",
            "L2",
            "L3"
          ],
          "description": "L1 카드 | L2 기구·신호 | L3 물리"
        },
        "thumbnail": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "maker_note": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "category"
      ]
    },
    "params": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "number",
              "integer",
              "boolean",
              "enum",
              "string"
            ]
          },
          "unit": {
            "default": "",
            "type": "string",
            "enum": [
              "mm",
              "deg",
              "mm/s",
              "kg",
              "s",
              "count",
              ""
            ]
          },
          "default": {
            "type": [
              "number",
              "boolean",
              "string"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "key",
          "label",
          "type"
        ]
      }
    },
    "geometry": {
      "type": "object",
      "properties": {
        "fn": {
          "type": "string",
          "minLength": 1,
          "description": "packages/blocks 의 지오메트리 함수 이름"
        },
        "dimTable": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "description": "예: 보어 32"
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "number"
                }
              },
              "verified": {
                "default": false,
                "type": "boolean"
              },
              "source": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "key",
              "values"
            ]
          }
        },
        "glbRef": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "fn"
      ]
    },
    "sockets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "mount",
              "inlet",
              "outlet",
              "surface",
              "tool"
            ]
          },
          "position": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "description": "길이 (mm)"
              },
              {
                "type": "number",
                "description": "길이 (mm)"
              },
              {
                "type": "number",
                "description": "길이 (mm)"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "normal": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "compatible": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mount",
                "inlet",
                "outlet",
                "surface",
                "tool"
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "position",
          "normal"
        ]
      }
    },
    "joints": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "rot",
              "lin",
              "surface"
            ]
          },
          "axis": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "mode": {
            "type": "string",
            "enum": [
              "onoff",
              "position",
              "continuous"
            ]
          },
          "rangeFrom": {
            "type": "string",
            "description": "min/max 를 계산할 파라미터 키 (예: stroke)"
          }
        },
        "required": [
          "name",
          "type",
          "axis",
          "mode",
          "rangeFrom"
        ]
      }
    },
    "ioTemplate": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^\\{n\\}_[A-Z0-9_]+$|^[A-Z][A-Z0-9_]*$"
          },
          "dir": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "bool",
              "int",
              "real"
            ]
          },
          "binding": {
            "type": "string",
            "enum": [
              "joint",
              "sensor",
              "process",
              "carrier",
              "trajectory"
            ]
          }
        },
        "required": [
          "tag",
          "dir",
          "type",
          "binding"
        ]
      }
    },
    "process": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "axes": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "cycle_time": {
              "default": 0,
              "type": "number",
              "minimum": 0
            },
            "judge": {
              "default": false,
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "carrier": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "capacity": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "layout": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "pitch": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "capacity",
            "layout",
            "pitch"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "robot": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "urdf": {
              "type": "string"
            },
            "payload": {
              "type": "number",
              "minimum": 0
            },
            "tcp_vmax": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tcp_amax": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "urdf",
            "payload",
            "tcp_vmax",
            "tcp_amax"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "detect": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "enum": [
                "ray",
                "segment",
                "area",
                "volume"
              ]
            },
            "range": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "target": {
              "default": "any",
              "type": "string",
              "enum": [
                "work",
                "carrier",
                "any"
              ]
            }
          },
          "required": [
            "shape",
            "range"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "meta",
    "geometry"
  ],
  "$id": "https://bse-digital-twin/schema/block.schema.json"
}
