{
  "name": "@bse/schema",
  "version": "0.1.0",
  "private": true,
  "description": "machine.json / factory.json / 블록 정의 / 편집 명령의 단일 출처 (zod → JSON Schema)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen": "tsx scripts/gen-json-schema.ts",
    "gen:doc": "tsx scripts/gen-command-doc.ts"
  },
  "dependencies": {
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "tsx": "^4.23.0"
  }
}
